@page
@model Assembly.RecipeApp.WebApp.Pages.Users.ManageRecipesModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            <li class="mb-1">
                                <a asp-page="/Users/Dashboard" class="list-group-item list-group-item-action rounded">Dashboard</a>
                            </li>

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a class="list-group-item list-group-item-action rounded disabled">Admin</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Manage Users</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageRecipes" class="list-group-item list-group-item-secondary list-group-item-action rounded">Manage Recipes</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a asp-page="/Users/UserRecipes" class="list-group-item list-group-item-action rounded">My Area</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>Admin</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Manage Users</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">
                        <a asp-page="/Admin/ManageUsers" class="btn btn btn-secondary ms-2">All Recipes</a>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <div class="row" style="">
                            <div class="col-12">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Recipe Name</th>
                                            <th scope="col">Author</th>
                                            <th scope="col">Approved</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var recipe in Model.Recipes)
                                        {
                                            <tr>
                                                <th style="width: 70px;" scope="row">@recipe.Id</th>
                                                <td style="width: 350px;">@recipe.Title</td>
                                                <td style="width: 100px;">@recipe.CreatedBy</td>
                                                <td style="width: 50px;">@(recipe.IsApproved ? "Active" : "Blocked")</td>

                                                <td>
                                                    <form method="post" asp-page-handler="ToggleBlock" asp-route-userId="@recipe.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm @(recipe.IsApproved ? "btn-danger" : "btn-success")" style="width: 60px;">
                                                            @(recipe.IsApproved ? "Block" : "Approve")
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Edit" asp-route-recipeId="@recipe.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-secondary">Edit</button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Delete" asp-route-recipeId="@recipe.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                                                        <button type="submit" class="btn btn-sm btn-danger" style="width: 60px;">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <!-- Pagination controls -->
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Recipes/ManageRecipes" asp-route-page="@Model.PreviousPage">Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-page="/Recipes/ManageRecipes" asp-route-page="@i">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Recipes/ManageRecipes" asp-route-page="@Model.NextPage">Next</a>
                                        </li>
                                    </ul>
                                </nav>

                            </div>
                        </div>

                    </div>

                </div>

            </main>

        </div>
    </div>
}
