@page
@model Assembly.RecipeApp.WebApp.Pages.Admin.ManageDifficultiesModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            <li class="mb-1">
                                <a asp-page="/Users/Dashboard" class="list-group-item list-group-item-action rounded">Dashboard</a>
                            </li>

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a class="list-group-item list-group-item-action rounded disabled">Admin</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Manage Users</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageRecipes" class="list-group-item list-group-item list-group-item-action rounded">Manage Recipes</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageProducts" class="list-group-item list-group-item list-group-item-action rounded">Manage Products</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageDifficulties" class="list-group-item list-group-item-secondary list-group-item-action rounded">Manage Difficulties</a>
                                </li>
                                <li class="mb-1 ms-4">
                                    <a asp-page="/Admin/ManageUnits" class="list-group-item list-group-item list-group-item-action rounded">Manage Units</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a asp-page="/Users/UserRecipes" class="list-group-item list-group-item-action rounded">My Area</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>Admin</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Manage Difficulties</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <a asp-page="/Admin/CreateDifficulty" class="btn btn btn-outline-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                            New Difficulty
                        </a>

                        <a asp-page="/Admin/ManageDifficulties" class="btn btn btn-secondary ms-2">All Difficulties</a>

                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <div class="row" style="">
                            <div class="col-12">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Difficulty Name</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var difficulty in Model.Difficulties)
                                        {
                                            <tr>
                                                <th style="width: 70px;" scope="row">@difficulty.Id</th>
                                                <td style="width: 650px;">@difficulty.Name</td>

                                                <td>
                                                    <form method="post" asp-page-handler="EditDifficulty" asp-route-difficultyId="@difficulty.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-secondary" style="width: 70px;">Edit</button>
                                                    </form>
                                                    <form method="post" asp-page-handler="DeleteDifficulty" asp-route-difficultyId="@difficulty.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                                                        <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                                        <button type="submit" class="btn btn-sm btn-danger" style="width: 70px;">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <!-- Pagination controls -->
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Admin/ManageDifficulties" asp-route-selectedPage="@Model.PreviousPage">Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-page="/Admin/ManageDifficulties" asp-route-selectedPage="@i">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Admin/ManageDifficulties" asp-route-selectedPage="@Model.NextPage">Next</a>
                                        </li>
                                    </ul>
                                </nav>

                            </div>
                        </div>

                    </div>

                </div>

            </main>

        </div>
    </div>
}
