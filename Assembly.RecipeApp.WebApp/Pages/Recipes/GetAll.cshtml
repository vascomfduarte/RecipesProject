@page
@model Assembly.RecipeApp.WebApp.Pages.Recipes.GetAllModel
@{
    ViewData["Title"] = "Recipes";

    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">        
    </head>
    <body>

        @if (Model.Recipes != null && Model.Recipes.Any())
        {
            @if (!@String.IsNullOrEmpty(@Model.SearchTerm))
            {
                <h5 class="text"><strong>Search Results for "@Model.SearchTerm"</strong></h5>
            }
            else
            {
                <h5 class="text"><strong>Search Results</strong></h5>
            }

            <h4 class="text-muted" style="font-size: 13px;">@Model.recipesCounter results</h4>
                        
            <div class="card-columns mb-3">
                @foreach (var recipe in Model.Recipes)
                {
                    int rating = recipe.GetRecipeRating();
                    int ratingCount = recipe.GetRecipeRatingCount();

                    <div class="card">
                        <a asp-page="/Recipes/Get" asp-route-id="@recipe.Id" style="color: inherit; text-decoration: none;">
                            <div class="card-img" id="recipeImageDiv-@recipe.Id" style="background-image: url('@recipe.ImageSource');"></div>
                            <div class="card-body" style="max-height: 100px; overflow: hidden;">
                                <h5 class="font-1-strong">@recipe.Title</h5>
                                <p class="font-1">@recipe.Description</p>
                            </div>
                        </a>

                        <div class="card-body" style="max-height: 40px;">                            
                            <span class="text-muted">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-star @(i < (rating == null ? 0 : rating) ? "checked" : "")" viewBox="0 0 16 16" style="margin-bottom: 2px;">
                                        <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                    </svg>
                                }
                            </span>
                            <span class="text-muted">
                                (@(ratingCount))
                            </span>
                        </div>

                        <div class="card-body d-flex justify-content-between align-items-center" style="max-height: 50px;">
                            <small class="text-muted me-1">
                                @recipe.MinutesToCook min
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dot" viewBox="0 0 16 16">
                                    <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3" />
                                </svg>
                                @recipe.Difficulty.Name
                            </small>
                            <div class="d-flex justify-content-end align-items-center" style="max-height: 50px;">
                                <small class="text-muted">By @recipe.CreatedBy</small>
                            </div>
                        </div>
                                   
                    </div>                    

                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            var img = new Image();
                            img.src = "@recipe.ImageSource";
                            img.onload = function () {
                                document.getElementById('recipeImageDiv-@recipe.Id').style.backgroundImage = "url('@recipe.ImageSource')";
                            }
                            img.onerror = function () {
                                document.getElementById('recipeImageDiv-@recipe.Id').style.backgroundImage = "url('/images/default_recipe.png')";
                            }
                        });
                    </script>
                }
            </div>

            <!-- Pagination controls -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Recipes/GetAll" asp-route-selectedPage="@Model.PreviousPage">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="/Recipes/GetAll" asp-route-selectedPage="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Recipes/GetAll" asp-route-selectedPage="@Model.NextPage">Next</a>
                    </li>
                </ul>
            </nav>
        }
        else
        {
            <h5 class="text"><strong>No results found</strong></h5>
        }
    </body>

}



