@page
@model Assembly.RecipeApp.WebApp.Pages.Recipes.GetModel
@{

    <div class="container mt-lg-5">
        <div class="row justify-content-center">

            <div class="col-md-6">

                <hr class="my-4 m-0 rounded" style="background-color:#B2B377; height: 7px">
                <h2 class="mt-5">@Model.Recipe.Title</h2>
                <p>By <strong>@Model.Recipe.User.Username</strong></p>
                <p class="text-muted">Published @Model.Recipe.CreatedDate.ToString("dd MMMM, yyyy")</p>

                <br />
                <hr class="my-4 m-0 rounded" style="background-color:#B2B377; height: 7px">
                <br />

                <div class="row">
                    <div class="col-md-3">
                        <p><strong>Preparation Time</strong></p>
                    </div>
                    <div class="col-md-3">
                        <p>@Model.Recipe.MinutesToCook min</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <p><strong>Difficulty</strong></p>
                    </div>
                    <div class="col-md-3">
                        <p>@Model.Recipe.Difficulty.Name</p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <p><strong>Rating</strong></p>
                    </div>
                    <div class="col-md-6">                        
                        <p class="text d-inline">
                            @(Model.Rating == null || Model.Rating == 0 ? "No Rating" : Model.Rating.ToString())


                            <span class="text-muted" style="margin-right: 2px; margin-left: 8px;">
                            @for (int i = 0; i < 5; i++)
                            {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-star @(i < (Model.Rating == null ? 0 : Model.Rating) ? "checked" : "")" viewBox="0 0 16 16" style="margin-bottom: 4px;">
                                        <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                    </svg>
                            }
                            </span>
                            <span class="text-muted">
                            @(Model.RatingCount)
                            </span>

                        </p>
                    </div>
                </div>

                <br />
                <br />
                <hr class="my-4 m-0 rounded" style="background-color:#B2B377; height: 7px">
            </div>

            <div class="col-md-6 d-flex justify-content-center align-items-center">
                <div class="card p-2" style="width: 650px; height: 520px; background-color:#E5E483;">
                    <img src="@Model.Recipe.ImageSource" class="card-img" style="object-fit: cover; width: 100%; height: 100%;" alt="Recipe Image">
                </div>
            </div>

        </div>
        <div class="row">

            <div class="col-md-6">
                
            </div>

            <div class="col-md-6 mt-3">
                <p>@Model.Recipe.Description </p>
            </div>

        </div>
    </div>
    
}