@page
@model Assembly.RecipeApp.WebApp.Pages.Recipes.ReadAllModel
@{
    ViewData["Title"] = "Recipes";

    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    </head>
    <body>

        @if (Model.Recipes != null && Model.Recipes.Any())
        {
            @if (!@String.IsNullOrEmpty(@Model.SearchTerm))
            {
                <h5 class="font-1-strong">Search Results for "@Model.SearchTerm"</h5>
            }
            else
            {
                <h5 class="font-1-strong">Search Results</h5>
            }

            <h4 class="font-1" style="font-size: 0.8rem;">@Model.recipesCounter results</h4>
                        
            <div class="card-columns">
                @foreach (var recipe in Model.Recipes)
                {
                    double rating = recipe.GetRecipeRating();
                    double ratingCount = recipe.GetRecipeRatingCount();

                    <div class="card">
                        <div class="card-img" style="background-image: url('@recipe.ImageSource');"></div>
                        <div class="card-body" style="max-height: 100px; overflow: hidden;">
                            <h5 class="font-1-strong">@recipe.Title</h5>
                            <p class="font-1">@recipe.Description</p>
                        </div>
                        <div class="card-body" style="max-height: 40px;">
                            <p class="font-1-light">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <span class="fa fa-star @(i < rating ? "checked" : "")"></span>
                                }         
                                @(rating > 0 ? @ratingCount : null)
                            </p>
                        </div>
                        <div class="card-body" style="max-height: 50px;">
                            <small class="text-muted">By @recipe.CreatedBy</small>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="font-1">No results found</p>
        }
    </body>

}



