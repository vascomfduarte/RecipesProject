@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

    <div class="container-fluid">
        <div class="jumbotron jumbotron-fluid bg-secondary text-center mt-4 mb-3 p-5 position-relative border shadow-sm" style="border-radius: 10px;">
            <div class="position-absolute top-0 start-0 w-100 h-100 " style="background: url(https://rb.gy/zb4pk5); background-size: cover; border-radius: 10px; filter: brightness(0.8);"></div>
            <div class="position-relative d-flex justify-content-center">
                <h1 class="font-weight-bold px-2 mx-auto rounded" style="width: fit-content;  color: white; text-shadow: 2px 2px 2px black;">Celestial Cuisine: Where Every Bite is Heavenly</h1>
            </div>
        </div>
    </div>

    

    <div class="container">
        <div class="row">

            <div class="col-8">
                <div class="jumbotron jumbotron-fluid p-2 m-1 border rounded shadow-sm" style="overflow:hidden;">
                    <div class="jumbotron jumbotron-fluid p-2 m-1 border rounded" style="background-color: white; overflow:hidden;">
                        <div style="height: 497px; overflow-y: auto;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-4">
                <div class="jumbotron jumbotron-fluid px-1 py-4 m-1 border rounded shadow-sm">

                    <div class="container">

                        <h2 class="font-weight-bold mt-1 mb-4 text-center">Top Rated Recipes</h2>

                        <div class="container" style="height: 425px; overflow-y: auto;">
                            @foreach (var recipe in Model.TopRatedRecipes)
                            {
                                <a asp-page="/Recipes/Get" asp-route-id="@recipe.Id" style="color: inherit; text-decoration: none;">

                                    <div class="row my-2 p-2 rounded d-flex justify-content-center border" >

                                        <div class="col-md-4 col-xs-6">
                                            <div class="d-flex align-items-center rounded-1" style="height: 80px; overflow:hidden;">
                                                <img src="@recipe.ImageSource" alt="@recipe.Title" class="img-fluid" onerror="this.onerror=null; this.src='/images/default_recipe.png';">
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-xs-6">
                                            <div class="d-flex align-items-center" style="height: 80px;">
                                                <p class="font-weight-normal">@recipe.Title</p>
                                            </div>
                                        </div>

                                    </div>

                                </a>
                            }
                        </div>                        

                    </div>   
                    
                </div>                
            </div>

        </div>
    </div>


}



                