@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

    <div class="container-fluid">
        <div class="jumbotron jumbotron-fluid bg-secondary text-white text-center mt-4 mb-3 p-5 position-relative border" style="border-radius: 10px;">
            <div class="position-absolute top-0 start-0 w-100 h-100 " style="background: url(https://rb.gy/zb4pk5); background-size: cover; border-radius: 10px;"></div>
            <div class="position-relative d-flex justify-content-center">
                <h1 class="text-dark display-6 px-2 mx-auto rounded" style="width: fit-content; background-color:#F1F5A8;">Celestial Cuisine: Where Every Bite is Heavenly</h1>
            </div>
        </div>
    </div>

    <hr class="my-4 m-3 rounded" style="background-color:#B2B377; height: 7px;">

    <div class="container">
        <div class="row">

            <div class="col-8">
                <div class="jumbotron jumbotron-fluid p-2 m-1 border rounded" style="background-color:#E5E483; overflow:hidden;">
                    <div class="jumbotron jumbotron-fluid p-2 m-1 border rounded" style="background-color: white; overflow:hidden;">
                        <div style="height: 504px; overflow-y: auto;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-4">
                <div class="jumbotron jumbotron-fluid px-1 py-4 m-1 border rounded" style="background-color:#E5E483; overflow:hidden;">
                    <div class="container">

                        <h2 class="font-weight-bold mt-3 mb-4 text-center">Top Rated Recipes</h2>

                        <div class="container" style="height: 420px; overflow-y: auto;">
                            @foreach (var recipe in Model.TopRatedRecipes)
                            {
                                <a asp-page="/Recipes/Get" asp-route-id="@recipe.Id" style="color: inherit; text-decoration: none;">

                                    <div class="row my-2 p-2 rounded d-flex justify-content-center border" style="background-color:#F1F5A8; overflow:hidden;">

                                        <div class="col-md-4 col-xs-6">
                                            <div class="d-flex align-items-center rounded-1" style="height: 80px; overflow:hidden;">
                                                <img src="@recipe.ImageSource" alt="@recipe.Title" class="img-fluid">
                                            </div>
                                        </div>
                                        <div class="col-md-8 col-xs-6">
                                            <div class="d-flex align-items-center" style="height: 80px;">
                                                <p class="font-weight-normal">@recipe.Title</p>
                                            </div>
                                        </div>

                                    </div>

                                </a>
                            }
                        </div>

                    </div>                    
                </div>                
            </div>

        </div>
    </div>


}



                