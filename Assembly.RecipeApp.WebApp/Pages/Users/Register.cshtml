@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Assembly.RecipeApp.WebApp.Pages.Users.RegisterModel
@{


    <div class="container mt-5 mb-5">
        <div class="row justify-content-center align-items-center h-100">

            <div class="card" style="border-radius: 15px; width:max-content;">
                <div class="card-body p-5">
                    <h2 class="text-uppercase text-center mb-5">Create account</h2>

                    <form method="POST">
                        <div class="row mt-2">
                            <div class="col-md-6">
                                <div class="form-outline mb-2">
                                    <input asp-for="UserData.FirstName" type="text" id="firstName" class="form-control form-control-lg" />
                                    <label class="form-label" for="firstName">First Name</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-outline mb-2">
                                    <input asp-for="UserData.LastName" type="text" id="lastName" class="form-control form-control-lg" />
                                    <label class="form-label" for="lastName">Last Name</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-outline mb-2">
                            <input asp-for="UserData.Username" type="text" id="username" class="form-control form-control-lg" />
                            <label class="form-label" for="username">Username</label>
                        </div>

                        <div class="form-outline mb-2">
                            <input asp-for="UserData.Email" type="email" id="email" class="form-control form-control-lg" />
                            <label class="form-label" for="email">Email</label>
                        </div>

                        <div class="form-outline mb-2">
                            <input asp-for="UserData.Password" type="password" id="password" class="form-control form-control-lg" />
                            <label class="form-label" for="password">Password</label>
                        </div>

                        <div class="form-outline mb-2">
                            <input type="password" id="confirmPassword" class="form-control form-control-lg" />
                            <label class="form-label" for="confirmPassword">Repeat your password</label>
                        </div>

                        <div class="form-check d-flex justify-content-center mb-5">
                            <input class="form-check-input me-2" type="checkbox" value="" id="form2Example3cg" />
                            <label class="form-check-label" for="form2Example3g">
                                I agree all statements in <a href="#!" class="text-body"><u>Terms of service</u></a>
                            </label>
                        </div>

                        <div class="d-flex justify-content-center">
                            <button type="submit" value="Submit" asp-page-handler="Submit" class="w-100 btn btn-primary btn-lg mb-4">Register</button>
                        </div>

                        <div class="text-center text-muted mt-4 mb-0">
                            <p>Have already an account? <a asp-page="/Users/Login">Login here</a></p>
                        </div>
                    </form>

                </div>
            </div>
            
        </div>
    </div>

	

}
