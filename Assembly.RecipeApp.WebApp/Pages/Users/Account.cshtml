@page
@model Assembly.RecipeApp.WebApp.Pages.Users.AccountModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">
                            
                            <li class="mb-1">
                                <a asp-page="/Users/Info" class="list-group-item list-group-item-secondary list-group-item-action rounded">Account</a>
                            </li>
                            <li>
                                <a asp-page="/Users/Info" class="list-group-item list-group-item-action rounded">Settings</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>Account</h2>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <form class="border-right">
                            <div class="p-3 py-2">

                                <div class="row mb-1">                                  
                                    <div class="col-md-12">
                                        <label for="username" class="labels"><strong>Username</strong></label>
                                        <input id="username" type="text" class="form-control" value="@Model.User.Username" readonly>
                                    </div>             
                                </div>
                                <div class="row mb-1">
                                    <div class="col-md-12">
                                        <label for="firstName" class="labels"><strong>First Name</strong></label>
                                        <input id="firstName" type="text" class="form-control" value="@Model.User.FirstName" readonly>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-md-12">
                                        <label for="lastName" class="labels"><strong>Last Name</strong></label>
                                        <input id="lastName" type="text" class="form-control" value="@Model.User.LastName" readonly>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-md-12">
                                        <label for="email" class="labels"><strong>Email</strong></label>
                                        <input id="email" type="email" class="form-control" value="@Model.User.Email" readonly>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-md-12">
                                        <label for="createdDate" class="labels"><strong>Created Date</strong></label>
                                        <input id="createdDate" type="text" class="form-control" value="@Model.User.CreatedDate.ToString("dd MMMM yyyy")" readonly>
                                    </div>
                                </div>                                
                            </div>
                        </form>
                        <div class="mt-4 p-3 py-2 col-12 d-flex justify-content-between">
                            <form method="POST" onsubmit="return confirm('Are you sure you want to delete your account?');">
                                @if (Model.User.IsAdmin is false)
                                {
                                    <button type="submit" class="btn btn-danger profile-button text-start">Delete Account</button>
                                }
                                else
                                {
                                    <button class="btn btn-warning profile-button text-start" disabled>
                                        Admin Account
                                    </button>
                                }
                            </form>
                            <form>
                                <button asp-page="/Users/Info" class="btn btn-secondary profile-button text-end">
                                    Settings
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-gear" viewBox="0 0 16 16">
                                        <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492M5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0" />
                                        <path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1-.52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.893 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.893-1.64-.902-3.433-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52zm-2.633.283c.246-.835 1.428-.835 1.674 0l.094.319a1.873 1.873 0 0 0 2.693 1.115l.291-.16c.764-.415 1.6.42 1.184 1.185l-.159.292a1.873 1.873 0 0 0 1.116 2.692l.318.094c.835.246.835 1.428 0 1.674l-.319.094a1.873 1.873 0 0 0-1.115 2.693l.16.291c.415.764-.42 1.6-1.185 1.184l-.291-.159a1.873 1.873 0 0 0-2.693 1.116l-.094.318c-.246.835-1.428.835-1.674 0l-.094-.319a1.873 1.873 0 0 0-2.692-1.115l-.292.16c-.764.415-1.6-.42-1.184-1.185l.159-.291A1.873 1.873 0 0 0 1.945 8.93l-.319-.094c-.835-.246-.835-1.428 0-1.674l.319-.094A1.873 1.873 0 0 0 3.06 4.377l-.16-.292c-.415-.764.42-1.6 1.185-1.184l.292.159a1.873 1.873 0 0 0 2.692-1.115z" />
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

            </main>

        </div>
    </div>
}
