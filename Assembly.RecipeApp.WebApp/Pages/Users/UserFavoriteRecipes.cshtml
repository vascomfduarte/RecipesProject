@page
@model Assembly.RecipeApp.WebApp.Pages.Users.UserFavoriteRecipesModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-action rounded disabled">My Area</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserRecipes" class="list-group-item list-group-item-action rounded">Recipes</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserComments" class="list-group-item list-group-item-action rounded">Comments</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Favorite Recipes</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>My Area</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Favorite Recipes</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <div class="row" style="">
                            <div class="col-12">

                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Recipe Name</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var recipe in Model.FavoriteRecipes)
                                        {
                                            <tr>
                                                <th style="width: 70px;" scope="row">@recipe.Id</th>
                                                <td style="width: 700px;">
                                                    <a asp-page="/Recipes/Get" asp-route-id="@recipe.Id" style="text-decoration: none; color:black">@recipe.Title</a>
                                                </td>
                                                <td>
                                                    <form method="post" asp-page-handler="Unfavorite" asp-route-recipeId="@recipe.Id" asp-route-userId="@Model.User.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to unfavorite this recipe?');">
                                                        <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                                        <button type="submit" class="btn btn-sm btn-danger" style="width: 100px;">Unfavorite</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <!-- Pagination controls -->
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Users/UserFavoriteRecipes" asp-route-selectedPage="@Model.PreviousPage">Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-page="/Users/UserFavoriteRecipes" asp-route-selectedPage="@i">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Users/UserFavoriteRecipes" asp-route-selectedPage="@Model.NextPage">Next</a>
                                        </li>
                                    </ul>
                                </nav>

                            </div>
                        </div>

                    </div>

                </div>

            </main>

        </div>
    </div>
}
