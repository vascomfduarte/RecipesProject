@page
@model Assembly.RecipeApp.WebApp.Pages.Users.EditUserRecipesModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <!-- User Side Menu -->
            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <!-- User Info -->
                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <!-- User Menu -->
                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-action rounded disabled">My Area</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Recipes</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserComments" class="list-group-item list-group-item-action rounded">Comments</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>My Area</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Recipes</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <a class="btn btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                            Edit Recipe
                        </a>

                        <a asp-page="/Users/UserRecipes" class="btn btn btn-outline-secondary ms-2">My Recipes</a>

                    </div>

                    <div class="card-body">

                        <div class="row rounded border m-3">
                            <div class="col-md-12">
                                <div class="d-flex flex-column align-items-center justify-content-center p-3">
                                    <img id="recipeImage" class="img-fluid rounded" width="400px" src="@Model.Recipe.ImageSource" alt="Recipe Image" onerror="setDefaultImage()">
                                </div>
                            </div>

                            <script>
                                function setDefaultImage() {
                                    document.getElementById('recipeImage').src = '/images/default_recipe.png';
                                }
                            </script>                            
                        </div>

                        <div class="row px-3">

                            <div class="d-flex flex-column align-items-end">
                                <form asp-page="/Users/EditUserRecipes" asp-page-handler="DeletePhoto" method="post">
                                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                                    <button type="submit" class="btn btn-outline-danger profile-button">
                                        Delete Photo
                                    </button>
                                </form>
                            </div>

                        </div>

                        <form class="border-right" method="post" asp-page-handler="Recipe" enctype="multipart/form-data">
                            <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                            <div class="px-3 py-0">

                                <div class="col-md-12">
                                    <label class="labels">Photo</label>
                                    <input asp-for="Photo" type="file" class="form-control">
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Title</label>
                                        <input asp-for="Title" type="text" class="form-control" placeholder="Enter recipe title" value="@Model.Recipe.Title" required>
                                        <span asp-validation-for="Title" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Description</label>
                                        <textarea asp-for="RecipeDescription" class="form-control" placeholder="Enter recipe description" value="@Model.RecipeDescription" style="height: 100px;" required>RecipeDescription</textarea>
                                        <span asp-validation-for="RecipeDescription" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Minutes to Cook</label>
                                        <input asp-for="MinutesToCook" type="number" class="form-control" placeholder="Enter minutes to cook" value="@Model.Recipe.MinutesToCook" required>
                                        <span asp-validation-for="MinutesToCook" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Difficulty</label>
                                        <select asp-for="DifficultyChoice" class="form-select">
                                            <option value="" disabled selected>@Model.Recipe.Difficulty.Name</option>
                                            @foreach (var dif in Model.Difficulties)
                                            {
                                                <option value="@dif.Name">@dif.Name</option>
                                            }
                                        </select>
                                        <span asp-validation-for="DifficultyChoice" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-md-6 text-start">
                                        <a asp-page="/Users/UserRecipes" class="btn btn-outline-secondary profile-button">
                                            Cancelar
                                        </a>
                                    </div>

                                    <div class="col-md-6 text-end">
                                        <button type="submit" value="Submit" class="btn btn-outline-secondary profile-button">
                                            Next
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-square" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm4.5 5.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5z" />
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                                                

                    </div>

                </div>

            </main>

        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
