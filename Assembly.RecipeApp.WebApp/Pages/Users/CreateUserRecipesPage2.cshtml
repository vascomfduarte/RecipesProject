@page
@model Assembly.RecipeApp.WebApp.Pages.Users.CreateUserRecipesPage2Model
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-action rounded disabled">My Area</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Recipes</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserComments" class="list-group-item list-group-item-action rounded">Comments</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>My Area</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Recipes</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <a class="btn btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                            New Recipe
                        </a>

                        <a asp-page="/Users/UserRecipes" class="btn btn btn-outline-secondary ms-2">My Recipes</a>

                    </div>

                    <div class="card-body">

                        <!-- Form for managing ingredients -->
                        <form method="post" asp-page-handler="AddIngredient">
                            <div class="p-3 mb-2 py-0">
                                <div class="col-md-12">

                                    <label class="labels">New Ingredient</label>
                                    <div id="ingredient">
                                        <!-- Form for adding a new ingredient -->
                                        <div class="row mt-1">
                                            <div class="col-md-4">
                                                <select asp-for="SelectedProduct" class="form-select" required>
                                                    <option value="" disabled selected>Select product</option>
                                                    @foreach (var product in Model.Products)
                                                    {
                                                        <option value="@product.Id">@product.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <input asp-for="IngredientAmount" type="number" class="form-control" placeholder="Enter amount" step="0.1" required>
                                            </div>
                                            <div class="col-md-3">
                                                <select asp-for="SelectedUnit" class="form-select" required>
                                                    <option value="" disabled selected>Select unit</option>
                                                    @foreach (var unit in Model.Units)
                                                    {
                                                        <option value="@unit.Id">@unit.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <input type="hidden" name="recipeId" value="@Model.Recipe.Id">
                                                <button type="submit" class="btn btn-success">Add</button>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </form>

                        <!-- Display current ingredients -->
                        @if (Model.RecipeIngredients.Any())
                        {
                            <p class="px-3">Ingredient List</p>

                            <div class="container" style="max-height: 138px; overflow-y: auto;">                                

                                @foreach (var ingredient in Model.RecipeIngredients)
                                {
                                    <div class="px-3 py-0">
                                        <div class="row mb-2">
                                            <div class="col-md-4">
                                                <input type="text" class="form-control" value="@ingredient.Product.Name" readonly />
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control" value="@ingredient.Amount" readonly />
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control" value="@ingredient.Unit.Name" readonly />
                                            </div>
                                            <div class="col-md-2">
                                                <!-- Form for deleting the ingredient -->
                                                <form method="post" asp-page-handler="DeleteIngredient">
                                                    <input type="hidden" name="ingredientId" value="@ingredient.Id">
                                                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                            
                        }

                        <!-- Form for setting preparation steps -->
                        <form method="post" asp-page-handler="AddPreparationStep">
                            <div class="p-3 py-0 mt-4 mb-2">
                                
                                <div class="row mt-3">

                                    <label class="labels mb-1">New Preparation Step</label>
                                    <div class="col-md-1">
                                        <span class="badge bg-secondary">@Model.PreparationStepCounter</span>
                                    </div>
                                    <div class="col-md-9">
                                        <input asp-for="StepDescription" type="text" class="form-control" placeholder="Enter step description" style="height: 90px;" value="" required>
                                    </div>
                                    <div class="col-md-1 text-end">
                                        <input type="hidden" name="recipeId" value="@Model.Recipe.Id">
                                        <button type="submit" class="btn btn-success profile-button">Add</button>
                                    </div>
                                
                                </div>                                

                            </div>
                        </form>

                        <!-- Display current steps -->
                        @if (Model.PreparationMethod != null && Model.PreparationSteps != null && Model.PreparationSteps.Any())
                        {
                            <p class="px-3 mt-2">Preparation Steps</p>

                            <div class="container" style="max-height: 190px; overflow-y: auto;">

                                @foreach (var step in Model.PreparationSteps)
                                {
                                    <div class="px-3 py-0">
                                        <div class="row mb-2">
                                            <div class="col-md-1">
                                                <span class="badge bg-secondary">@step.Order</span>
                                            </div>
                                            <div class="col-md-9">
                                                <input type="text" class="form-control" value="@step.Description" style="height: 90px;" readonly />
                                            </div>
                                            <div class="col-md-1">
                                                <!-- Form for deleting the ingredient -->
                                                <form method="post" asp-page-handler="DeletePreparationStep">
                                                    <input type="hidden" name="stepId" value="@step.Id">
                                                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id">
                                                    <button type="submit" class="btn btn-danger">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                        </svg>
                                                    </button>
                                                </form>                                                
                                            </div>

                                            <div class="col-md-1">
                                                <!-- Form for editing the ingredient
                                                <form method="post" asp-page-handler="DeletePreparationStep">
                                                    <input type="hidden" name="stepId" value="@step.Id">
                                                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id">
                                                    <button type="submit" class="btn btn-danger">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                        </svg>
                                                    </button>
                                                </form>
                                                 -->
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        }

                        <!-- Submit Recipe or go back -->
                        <div class="row mt-4">

                            <!-- Column for the back button on the left -->
                            <div class="col-md-6 text-start">
                                <a asp-page="/Users/EditUserRecipes" asp-route-recipeId="@Model.Recipe.Id" class="btn btn-outline-secondary profile-button">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-square" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M15 2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1zM0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm11.5 5.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
                                    </svg>
                                    Back
                                </a>
                            </div>

                            <!-- Column for the submit button on the right -->
                            <div class="col-md-6 text-end">                                
                                <a asp-page="/Recipes/Get" asp-route-id="@Model.Recipe.Id" class="btn btn-outline-secondary profile-button">                                    
                                    Submit Recipe
                                </a>
                            </div>
                        </div>
                        

                    </div>

                </div>

            </main>

        </div>
    </div>
}
