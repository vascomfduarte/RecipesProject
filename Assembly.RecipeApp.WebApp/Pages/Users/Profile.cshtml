@page
@model Assembly.RecipeApp.WebApp.Pages.Users.ProfileModel
@{
    ViewData["Title"] = "User Profile";

    
    <div class="container rounded bg-white p-2">

        <div class="jumbotron jumbotron-fluid rounded" style="background-color:#F1F5A8;">

            <div class="row">
                <div class="col-lg-2 col-md-4 col-sm-6">
                    <div class="d-flex flex-column align-items-start justify-content-center p-4">
                        <img class="rounded-circle" width="170px" src="@Model.userImage" alt="User Image">
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6">
                    <div class="d-flex flex-column align-items-start justify-content-center h-100 p-2">
                        <h3 class="font-weight-bold">@Model.User.FirstName @Model.User.LastName</h3>
                        <!-- Add more user information as needed -->
                    </div>
                </div>
                <div class="col-lg-6 d-sm-none"></div>
                <div class="col-lg-2 d-sm-none"></div>
            </div>         

        </div>        

        <div class="row"></div>

    </div>
    
}
