                        <h3 class="font-weight-bold">@Model.User.FirstName @Model.User.LastName</h3>
                    </div>
                </div>

                <hr class="my-2 m-2 rounded" style="background-color:#B2B377; height: 7px;">

                <div class="row mb-3 mx-1 d-flex align-items-center justify-content-center">

                    <div class="col-5 d-flex flex-column align-items-start justify-content-end">
                        <p>User Info</p>
                    </div>
                    <div class="col-5 d-flex flex-column align-items-end">
                        <button asp-page="/Recipes/GetAll" class="btn btn-outline-secondary" type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
