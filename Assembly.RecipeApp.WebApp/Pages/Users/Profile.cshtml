    <div class="container rounded bg-white p-2">

        <div class="col-3">

            <div class="jumbotron jumbotron-fluid rounded" style="background-color:#F1F5A8;">

                <div class="row">
                    <div class="d-flex flex-column align-items-center justify-content-center p-4">
                        <img class="rounded-circle" width="170px" src="@Model.userImage" alt="User Image">
                    </div>
                </div>

                <div class="row">
