@page
@model Assembly.RecipeApp.WebApp.Pages.Users.AccountSettingsModel
@{
	ViewData["Title"] = "User Dashboard";

	<head>

	</head>
	<body>
        <div class="container rounded bg-white mt-2 mb-5">

            <form method="POST">

                <div class="row">
                    <div class="col-md-4 border-right">
                        <div class="d-flex flex-column align-items-center text-center p-3 py-5">
                            <img class="rounded-circle mt-5" width="150px" src="@Model.userImage">
                            <span class="font-weight-bold">@Model.User.Username</span>
                            <span class="text-black-50">@Model.User.Email</span>
                            <span> </span>
                        </div>
                    </div>
                    <div class="col-md-5 border-right">
                        <div class="p-3 py-5">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="text-right">Account Settings</h4>
                            </div>
                            <input type="hidden" asp-for="User.Id" />
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <label class="labels">First Name</label>
                                    <input asp-for="User.FirstName" type="text" class="form-control" placeholder="@Model.User.FirstName">
                                </div>
                                <div class="col-md-6">
                                    <label class="labels">Last Name</label>
                                    <input asp-for="User.LastName" type="text" class="form-control" placeholder="@Model.User.LastName">
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-12">
                                    <label class="labels">Email</label>
                                    <input asp-for="User.Email" type="email" class="form-control" placeholder="@Model.User.Email">
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <label class="labels">Password</label>
                                    <input asp-for="User.Password" type="password" class="form-control" placeholder="password">
                                </div>
                                <div class="col-md-6">
                                    <label class="labels">Confirm Password</label>
                                    <input type="password" class="form-control" placeholder="confirm password">
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-12 mt-2">
                                    <label class="labels">Biography</label>
                                    <input asp-for="User.ContentBio" type="text" class="form-control" placeholder="write something about you" value="">
                                </div>
                            </div>
                            <div class="mt-5 text-center">
                                <button asp-page-handler="Update" class="btn btn-primary profile-button" type="submit">Update Profile</button>
                            </div>
                        </div>
                    </div>

                </div>
			
			</form>
            
        </div>
	</body>
}
