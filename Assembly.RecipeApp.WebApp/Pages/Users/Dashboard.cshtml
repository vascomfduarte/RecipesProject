@page
@model Assembly.RecipeApp.WebApp.Pages.Users.DashboardModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Dashboard</a>
                            </li>

                            @if(Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Users/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a asp-page="/Users/UserRecipes" class="list-group-item list-group-item-action rounded">My Area</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>Dashboard</h2>
                    </div>

                </div>               

            </main>

        </div>
    </div>
}
