@page
@model Assembly.RecipeApp.WebApp.Pages.Users.UserCommentsModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            <li class="mb-1">
                                <a asp-page="/Users/Dashboard" class="list-group-item list-group-item-action rounded">Dashboard</a>
                            </li>

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-action rounded disabled">My Area</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserRecipes" class="list-group-item list-group-item-action rounded">Recipes</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Comments</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>My Area</h2>
                    </div>                   

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Comments</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">
                        <a asp-page="/Users/UserComments" class="btn btn btn-secondary ms-2">My Comments</a>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <div class="row" style="">
                            <div class="col-12">
                                <table class="table table-striped">

                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Recipe Name</th>
                                            <th scope="col">Comment</th>
                                            <th scope="col">Published Date</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comment in Model.Comments)
                                        {
                                            <tr>
                                                <th style="width: 70px;" scope="row">@comment.Id</th>
                                                <td style="width: 200px;">@comment.Recipe.Title</td>
                                                <td style="width: 400px;">
                                                    <div class="comment-preview">
                                                        <div class="d-inline-flex">
                                                            <span class="short-comment">@comment.Body.Substring(0, Math.Min(40, comment.Body.Length))@(comment.Body.Length > 40 ? "" : "")</span>
                                                            @if (comment.Body.Length > 40)
                                                            {
                                                                <button type="button" onclick="toggleComment('@comment.Id')" class="expand-button btn btn-link p-0 ms-2">
                                                                    <svg id="icon-plus-@comment.Id" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                                                        <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                                                                    </svg>
                                                                    <svg id="icon-minus-@comment.Id" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-square d-none" viewBox="0 0 16 16">
                                                                        <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                                                        <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                                                    </svg>
                                                                </button>
                                                            }
                                                        </div>
                                                        <div id="full-comment-@comment.Id" class="full-comment d-none">@comment.Body</div>
                                                    </div>
                                                </td>
                                                <td style="width: 150px;">@comment.CreatedDate.ToString("dd MMM yyyy, HH:mm")</td>
                                                <td>
                                                    <form method="post" asp-page-handler="Delete" asp-route-commentId="@comment.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                                        <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                                        <button type="submit" class="btn btn-sm btn-danger" style="width: 70px;">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <!-- Pagination controls -->
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Admin/ManageRecipes" asp-route-selectedPage="@Model.PreviousPage">Previous</a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" asp-page="/Admin/ManageRecipes" asp-route-selectedPage="@i">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-page="/Admin/ManageRecipes" asp-route-selectedPage="@Model.NextPage">Next</a>
                                        </li>
                                    </ul>
                                </nav>

                                <script>
                                    function toggleComment(commentId) {
                                        var fullComment = document.getElementById('full-comment-' + commentId);
                                        var shortComment = document.getElementById('short-comment-' + commentId);
                                        var iconPlus = document.getElementById('icon-plus-' + commentId);
                                        var iconMinus = document.getElementById('icon-minus-' + commentId);

                                        if (fullComment.classList.contains('d-none')) {
                                            fullComment.classList.remove('d-none');
                                            shortComment.classList.add('d-none');
                                            iconPlus.classList.add('d-none');
                                            iconMinus.classList.remove('d-none');
                                        } else {
                                            fullComment.classList.add('d-none');
                                            shortComment.classList.remove('d-none');
                                            iconPlus.classList.remove('d-none');
                                            iconMinus.classList.add('d-none');
                                        }
                                    }
                                </script>

                                <style>
                                    .comment-preview {
                                        max-width: 340px;
                                    }

                                    .full-comment {
                                        display: block;
                                        margin-top: 10px;
                                        white-space: pre-wrap;
                                        word-wrap: break-word;
                                    }

                                    .d-none {
                                        display: none;
                                    }
                                </style>

                            </div>
                        </div>

                    </div>

                </div>

            </main>

        </div>
    </div>
}
