@page
@model Assembly.RecipeApp.WebApp.Pages.Users.CreateUserRecipesModel
@{
    <div class="container-fluid pb-3">
        <div class="d-flex flex-wrap">

            <aside class="flex-grow-3">
                <div class="card border rounded-3 p-1 h-30">

                    <div class="card-header jumbotron jumbotron-fluid border rounded-3 h-70 mb-3">

                        <div class="row">
                            <div class="d-flex flex-column align-items-center justify-content-center p-4">
                                <img class="rounded-circle img-fluid" width="170px" src="@Model.UserImage" alt="User Image">
                            </div>
                        </div>

                        <div class="col-md-12 d-flex flex-column align-items-center justify-content-center">
                            <h3 class="font-weight-bold text-center">@Model.User.FirstName @Model.User.LastName</h3>
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="nav nav-pills flex-sm-column flex-row mb-auto justify-content-between text-truncate ">

                            <li class="mb-1">
                                <a asp-page="/Users/Dashboard" class="list-group-item list-group-item-action rounded">Dashboard</a>
                            </li>

                            @if (Model.User.IsAdmin is true)
                            {
                                <li class="mb-1">
                                    <a asp-page="/Admin/ManageUsers" class="list-group-item list-group-item-action rounded">Admin</a>
                                </li>
                            }

                            <li class="mb-1">
                                <a class="list-group-item list-group-item-action rounded disabled">My Area</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a class="list-group-item list-group-item-secondary list-group-item-action rounded">Recipes</a>
                            </li>
                            <li class="mb-1 ms-4">
                                <a asp-page="/Users/UserComments" class="list-group-item list-group-item-action rounded">Comments</a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>

            <main class="flex-grow-1 ms-4">

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h2>My Area</h2>
                    </div>

                </div>

                <div class="card border rounded-3 p-1 mb-2 w-100">

                    <div class="card-header border rounded-3">
                        <h3>Recipes</h3>
                    </div>

                    <div class="card-body flex-column align-items-center justify-content-center">

                        <a class="btn btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                            New Recipe
                        </a>

                        <a asp-page="/Users/UserRecipes" class="btn btn btn-outline-secondary ms-2">My Recipes</a>

                    </div>

                    <div class="card-body">

                        <form class="border-right" method="POST">
                            <div class="p-3 py-0">
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="labels">Photo</label>
                                        <input asp-for="Photo" type="file" class="form-control">
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Title</label>
                                        <input asp-for="Title" type="text" class="form-control" placeholder="Enter recipe title" value="" required>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Description</label>
                                        <textarea asp-for="Description" type="text" class="form-control" placeholder="Enter recipe description" style="height: 100px;" required></textarea>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Minutes to Cook</label>
                                        <input asp-for="MinutesToCook" type="number" class="form-control" placeholder="Enter minutes to cook" value="" required>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Difficulty</label>
                                        <select asp-for="DifficultyChoice" class="form-select" required>
                                            <option value="" disabled selected>Select difficulty</option>
                                            @foreach (var dif in Model.Difficulties)
                                            {
                                                <option value="@dif">@dif.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Ingredients</label>
                                        <div id="ingredients">
                                            <!-- Ingredients will be dynamically added here -->
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary mt-2" onclick="addIngredient()">Add Ingredient</button>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-12">
                                        <label class="labels">Preparation Steps</label>
                                        <div id="preparationSteps">
                                            <!-- Preparation steps will be dynamically added here -->
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary mt-2" onclick="addPreparationStep()">Add Step</button>
                                    </div>
                                </div>                           
                                <div class="row mt-4 text-end">
                                    <div class="col-md-12">
                                        <button type="submit" value="Submit" class="btn btn-secondary profile-button">Create Recipe</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    
                    </div>

                </div>

            </main>

        </div>
    </div>

    <script>
        let ingredientCounter = 1;
        let preparationStepCounter = 1;

        // Ensure at least one ingredient and one preparation step exist initially
        addIngredient();
        addPreparationStep();

        function addIngredient() {
            const ingredientsContainer = document.getElementById('ingredients');

            const ingredientDiv = document.createElement('div');
            ingredientDiv.classList.add('row', 'mt-2', 'ingredient');
            ingredientDiv.innerHTML = `
                <div class="col-md-5">
                    <select asp-for="ProductName" class="form-select" required>
                        <option value="" disabled selected>Select product</option>
                        @foreach (var product in Model.Products)
                        {
                            <option value="@product">@product</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input asp-for="Amount" type="number" class="form-control" placeholder="Enter amount" step="0.01" required>
                </div>
                <div class="col-md-3">
                    <select asp-for="UnitName" class="form-select" required>
                        <option value="" disabled selected>Select unit</option>
                        @foreach (var unit in Model.Units)
                        {
                            <option value="@unit.Id">@unit.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger" onclick="removeIngredient(this)">Remove</button>
                </div>
            `;

            ingredientsContainer.appendChild(ingredientDiv);
            ingredientCounter++;
        }

        function removeIngredient(button) {
            const ingredientDiv = button.closest('.ingredient');
            ingredientDiv.remove();
        }

        function addPreparationStep() {
            const stepsContainer = document.getElementById('preparationSteps');

            const stepDiv = document.createElement('div');
            stepDiv.classList.add('row', 'mt-2', 'step');
            stepDiv.innerHTML = `
                <div class="col-md-1">
                    <span class="badge bg-secondary">${preparationStepCounter}</span>
                </div>
                <div class="col-md-9">
                    <textarea type="text" class="form-control" placeholder="Enter preparation step" style="height: 100px;" required></textarea>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-danger" onclick="removeStep(this)">Remove</button>
                </div>
            `;

            stepsContainer.appendChild(stepDiv);
            preparationStepCounter++;
        }

        function removeStep(button) {
            const stepDiv = button.closest('.step');
            stepDiv.remove();
            // Re-index the steps
            const steps = document.querySelectorAll('.step');
            preparationStepCounter = 1;
            steps.forEach(step => {
                step.querySelector('.badge').innerText = preparationStepCounter;
                preparationStepCounter++;
            });
        }
    </script>

}
